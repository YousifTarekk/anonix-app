                "{{baseUrl}}"
              ],
              "path": [
                "request"
              ]
            },
            "description": "Login as the SENDER. Shows all identity requests you received."
          }
        },
        {
          "name": "accept-or-reject-request",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"accepted\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/request/{{requestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "request",
                "{{requestId}}"
              ]
            },
            "description": "Login as the SENDER. status: 'accepted' or 'rejected'. Accepting creates a conversation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json().data?.conversation; if (c) pm.collectionVariables.set('conversationId', c._id);"
                ]
              }
            }
          ]
        }
