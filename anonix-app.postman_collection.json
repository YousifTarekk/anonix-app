    {
      "name": "request",
      "item": [
        {
          "name": "request-sender-identity",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/request/{{messageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "request",
                "{{messageId}}"
              ]
            },
            "description": "Login as the RECEIVER of the message."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('requestId', pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "get-requests",
          "request": {
            "method": "GET",
