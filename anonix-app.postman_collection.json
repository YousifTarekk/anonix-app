        {
          "name": "send-message",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"content\": \"kefe kda\",\n    \"receiver\": \"{{receiverId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/message/public",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "message",
                "public"
              ]
            },
            "description": "Login first. Sender is saved, so the receiver can request your identity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('messageId', pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "send-anonymous-message",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"content\": \"kefe kda\",\n    \"receiver\": \"{{receiverId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/message",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "message"
              ]
            },
            "description": "No login needed. Sender is never saved, so identity can never be requested."
          }
        },
        {
          "name": "get-all-messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/message",
